# Mẫu cấu hình. Chép thành .env.development rồi điền giá trị thật:
#
#   cp apps/backend/.env.example apps/backend/.env.development
#
# File .env.development KHÔNG được đưa lên Git — nó chứa khoá ký token.

NODE_ENV=development
PORT=2567
BACKEND_URL=http://localhost:2567

# PostgreSQL chạy bằng docker compose ở thư mục gốc của co-ty-phu.
# Để trống thì server vẫn chạy nhưng không lưu gì.
DATABASE_URL=postgres://cotyphu:cotyphu@localhost:5432/cotyphu

# Khoá ký token đăng nhập và phiên. Sinh giá trị riêng cho mỗi môi trường:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Lấy từ Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Để trống thì server bật đăng nhập khách để chạy thử.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
